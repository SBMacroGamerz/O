        <!--
          Device Admin receiver (Host side only). Lets a parent require the
          4-digit PIN to deactivate admin before uninstall is possible.
          Android ALWAYS shows its own "Deactivate this device admin app?"
          system screen first — no app can hide or skip that system UI.
          The PIN gate below is implemented as an in-app screen shown when
          the child taps "Deactivate" from that system screen's link back
          into the app's admin-settings flow.
        -->
        <receiver
            android:name=".DeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>

